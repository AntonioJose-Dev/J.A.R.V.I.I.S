# Copia este archivo a .env y rellena tus claves. Nunca subas .env a GitHub.

# LiveKit (servidor de voz). En local: `livekit-server --dev` usa estas:
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Cerebro
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5-5

# Oído y voz
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
# ID de la voz de ElevenLabs que elijas tras la prueba de voces
ELEVEN_VOICE_ID=
# Un solo modelo para llamadas, voz del PC y notas de Telegram: JARVIS suena igual en todas partes
ELEVEN_MODEL=eleven_v4_turbo
# Naturalidad: estabilidad baja = más expresiva; similitud alta = más fiel a la voz; estilo = más interpretación
ELEVEN_STABILITY=0.4
ELEVEN_SIMILARITY=0.8
ELEVEN_STYLE=0.3

# Modo: auto (por defecto) | prueba | completo
# auto: cerebro Claude si hay ANTHROPIC_API_KEY; si no, Groq o Gemini (gratis).
#       voz ElevenLabs si hay ELEVEN_API_KEY; si no, la voz española de Deepgram.
JARVIS_MODO=auto

# Cerebro gratuito para pruebas (basta con una de las dos)
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
JARVIS_GROQ_MODEL=openai/gpt-oss-120b
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-2.5-flash

# Voz de Deepgram cuando no hay ElevenLabs
JARVIS_DEEPGRAM_VOICE=aura-2-alvaro-es

# Llamadas telefónicas reales (ver README, "Llamadas de teléfono").
# Para llamar, LIVEKIT_URL/API_KEY/API_SECRET de arriba deben ser los de tu proyecto de LiveKit Cloud.
TELNYX_SIP_USUARIO=
TELNYX_SIP_CLAVE=
# Número que verá quien recibe la llamada: tu móvil verificado en Telnyx o un número comprado, p. ej. +34600000000
JARVIS_CALLER_ID=
# Lo da scripts/configurar_llamadas.py
LIVEKIT_SIP_TRUNK_ID=
# Prefijos a los que se permite llamar (por defecto España y la UE), p. ej. 34,351
JARVIS_PREFIJOS_LLAMADA=
# Duración máxima de cada llamada, en segundos
JARVIS_LLAMADA_MAX_SEGUNDOS=180

# Telegram: crea el bot con @BotFather y pega aquí su token.
# Luego escríbele /id al bot y pon tu número en TELEGRAM_ALLOWED_IDS (varios, separados por comas).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Cómo te llama JARVIS
JARVIS_OWNER_NAME=Potro

# Memoria (archivo local; más adelante PostgreSQL + pgvector)
JARVIS_MEMORY_PATH=jarvis_memoria.db

# Servidores MCP opcionales, separados por comas (p. ej. Home Assistant)
JARVIS_MCP_URLS=
