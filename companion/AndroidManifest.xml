<?xml version="1.0" encoding="utf-8"?>
<!-- JARVIS Companion: pulsa "Enviar" en WhatsApp SOLO para el mensaje exacto que JARVIS ha ordenado
     (orden firmada con un secreto y de hace menos de 60 segundos). Base de la futura app "Oye Jarvis". -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jarvis.companion"
    android:versionCode="5"
    android:versionName="1.4">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <!-- Solo para avisar al agente de JARVIS en este mismo móvil (127.0.0.1); no sale a internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="JARVIS"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@android:drawable/ic_btn_speak_now">

        <activity android:name=".Inicio" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ya no hay receptor de mensajes de Android: la app solo pide órdenes al agente de JARVIS (127.0.0.1) -->

        <service
            android:name=".Accesibilidad"
            android:exported="true"
            android:label="JARVIS: enviar WhatsApp"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accesibilidad" />
        </service>
    </application>
</manifest>
