<?xml version="1.0" encoding="utf-8"?>
<!-- JARVIS Companion: pulsa "Enviar" en WhatsApp SOLO para el mensaje exacto que JARVIS ha ordenado
     (orden firmada con un secreto y de hace menos de 60 segundos). Base de la futura app "Oye Jarvis". -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jarvis.companion"
    android:versionCode="27"
    android:versionName="2.7">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <!-- Para hablar con JARVIS en el PC por Tailscale (red privada y cifrada) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para escucharte cuando lo despiertas (botón lateral / palmadas) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- «Actualizar JARVIS»: instalar su propia actualización (bajada de tu PC); Android pide confirmación siempre -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- «No molestar» y brillo: Android pide confirmarlos una vez en Ajustes -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Palmadas: escuchar en segundo plano (con aviso fijo, como exige Android) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Para pedir que Android no duerma la app (si la duerme, deja de recibir los encargos de JARVIS) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Desde Android 11 una app solo "ve" las apps que declara aquí: sin esto, WhatsApp parece no instalado -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- Para poder abrir cualquier app por su nombre ("abre YouTube") -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="JARVIS"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/red"
        android:icon="@android:drawable/ic_btn_speak_now">

        <activity android:name=".Inicio" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Oye JARVIS": asistente del móvil (mantener pulsado el botón lateral) -->
        <activity
            android:name=".Escuchar"
            android:exported="true"
            android:label="Hablar con JARVIS"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity="com.jarvis.companion.escuchar">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver android:name=".Actualizador" android:exported="false" />

        <service
            android:name=".Palmadas"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Sin receptores de mensajes: la app solo recibe trabajo de JARVIS en el PC, con su código secreto -->

        <service
            android:name=".Accesibilidad"
            android:exported="true"
            android:label="JARVIS: enviar WhatsApp"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accesibilidad" />
        </service>
    </application>
</manifest>
